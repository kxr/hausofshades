---
import Base from '../layouts/Base.astro';
import Quad from '../components/Quad.astro';
import Photo from '../components/Photo.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { studio, callSheet } from '../data/studios';
import { photo } from '../lib/photos';
import { site } from '../site.config';
import { url } from '../lib/paths';

const hair = studio('hair');
const beauty = studio('beauty');
const bridal = studio('bridal');
const creative = studio('creative');

const beautyFaces = [
  'beauty/01-red-lip-portrait',
  'beauty/02-emerald-garden',
  'beauty/04-ivory-satin-glam',
  'beauty/09-beaded-veil',
  'beauty/05-smoky-waves',
].map(photo);
const creativeRow = [
  'creative/03-feathered-blue',
  'creative/04-white-mask',
  'creative/06-mirror-ball',
  'creative/08-space-buns',
].map(photo);
---

<Base description="Haus of Shades Studio: award-winning hair and makeup by Saba Mughal. Studio appointments in Doreen, Melbourne, bridal hair and makeup, and on-set teams across Victoria.">
  <section class="hero ground-plum">
    <div class="wrap hero__inner">
      <h1 class="hero__title"><span>Shades of you,</span> <span>done beautifully</span></h1>
      <p class="hero__lede">
        Hair, beauty, bridal and creative work by award-winning artist Saba Mughal, from the Doreen studio to sets
        across Victoria.
      </p>
      <Quad />
      <div class="actions hero__actions">
        <a class="btn" href={site.fresha} target="_blank" rel="noopener">
          Book now<span class="visually-hidden"> on Fresha (opens in a new tab)</span>
        </a>
        <a class="btn btn--line" href={url('enquire/?for=agency')}>Agency enquiries</a>
      </div>
    </div>
  </section>

  <section class="band ground-blush" aria-labelledby="beauty-title">
    <div class="wrap beauty">
      <h2 class="display beauty__title" id="beauty-title">{beauty.name}</h2>
      <div class="beauty__text">
        <p class="lede">{beauty.intro}</p>
        <div class="actions">
          <a class="btn" href={site.fresha} target="_blank" rel="noopener">
            Book on Fresha<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          <a class="btn btn--line" href={url('enquire/?for=beauty')}>{beauty.enquiryLabel}</a>
        </div>
      </div>
    </div>
    <ul class="faces" role="list" data-zoom-group aria-label="Beauty Studio looks">
      {
        beautyFaces.map((p) => (
          <li>
            <Photo photo={p} cover sizes="(min-width: 60em) 19vw, 64vw" />
          </li>
        ))
      }
    </ul>
    <div class="wrap">
      <a class="text-link" href={url('beauty/')}>See the Beauty Studio</a>
    </div>
  </section>

  <section class="band ground-mauve" aria-labelledby="hair-title">
    <div class="wrap hair">
      <div class="hair__text">
        <h2 class="display" id="hair-title">{hair.name}</h2>
        <p class="lede">{hair.intro}</p>
        <div class="actions">
          <a class="btn" href={site.fresha} target="_blank" rel="noopener">
            Book on Fresha<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          <a class="btn btn--line" href={url('enquire/?for=hair')}>{hair.enquiryLabel}</a>
        </div>
        <a class="text-link" href={url('hair/')}>See the Hair Studio</a>
      </div>
      <BeforeAfter
        class="hair__ba"
        photo={photo('hair/03-smoothing-before-after')}
        sizes="(min-width: 60em) 44vw, 100vw"
        caption="Before and after a smoothing treatment"
      />
      <div class="hair__row" data-zoom-group>
        <Photo photo={photo('hair/01-hollywood-waves')} cover sizes="(min-width: 60em) 18vw, 33vw" />
        <Photo photo={photo('hair/04-blended-highlights')} cover sizes="(min-width: 60em) 18vw, 33vw" />
        <Photo photo={photo('hair/02-heart-braid-crown')} cover sizes="(min-width: 60em) 18vw, 33vw" />
      </div>
    </div>
  </section>

  <section class="band ground-sand" aria-labelledby="bridal-title">
    <div class="wrap bridal">
      <Photo
        class="bridal__photo"
        photo={photo('bridal/02-garden-walk')}
        sizes="(min-width: 60em) 40vw, 100vw"
      />
      <div class="bridal__text">
        <h2 class="display" id="bridal-title">{bridal.name}</h2>
        <p class="lede">{bridal.intro}</p>
        <ol class="steps" role="list">
          <li>
            <h3>Enquire</h3>
            <p>Send your date, venue and how many people need hair and makeup.</p>
          </li>
          <li>
            <h3>Trial</h3>
            <p>Try your look at the Doreen studio and adjust it until it feels like you.</p>
          </li>
          <li>
            <h3>Wedding day</h3>
            <p>The team comes to your venue or home and gets everyone ready.</p>
          </li>
        </ol>
        <div class="actions">
          <a class="btn" href={url('enquire/?for=bridal')}>{bridal.enquiryLabel}</a>
        </div>
        <a class="text-link" href={url('bridal/')}>See the Bridal Studio</a>
      </div>
    </div>
  </section>

  <section class="band ground-deep" aria-labelledby="creative-title">
    <div class="wrap creative">
      <div class="creative__text">
        <h2 class="display" id="creative-title">{creative.name}</h2>
        <p class="lede">{creative.intro}</p>
        <div class="actions">
          <a class="btn" href={url('enquire/?for=creative')}>{creative.enquiryLabel}</a>
        </div>
        <a class="text-link" href={url('creative/')}>See the Creative Studio</a>
      </div>
      <Photo
        class="creative__lead"
        photo={photo('creative/02-gold-leaf-braids')}
        sizes="(min-width: 60em) 46vw, 100vw"
      />
      <div class="creative__row" data-zoom-group>
        {creativeRow.map((p) => <Photo photo={p} cover sizes="(min-width: 60em) 22vw, 50vw" />)}
      </div>
    </div>
  </section>

  <section class="band ground-plum" id="on-set" aria-labelledby="on-set-title">
    <div class="wrap on-set">
      <div class="on-set__text">
        <h2 class="display" id="on-set-title">On-set teams for agencies and fashion houses</h2>
        <p class="lede">
          Hair and makeup teams for creative shoots, campaigns and runway productions, from a single artist to a
          full crew backstage.
        </p>
        <div class="actions">
          <a class="btn" href={url('enquire/?for=agency')}>Agency enquiries</a>
        </div>
      </div>
      <div class="on-set__sheet">
        <h3>What to send with your enquiry</h3>
        <dl class="call-sheet">
          {
            callSheet.map((row) => (
              <div>
                <dt>{row.term}</dt>
                <dd>{row.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="on-set__photos" data-zoom-group>
        <Photo
          class="on-set__wide"
          photo={photo('on-set/01-runway-team')}
          cover
          sizes="(min-width: 60em) 58vw, 100vw"
        />
        <Photo
          class="on-set__tall"
          photo={photo('on-set/03-gold-leaf-application')}
          cover
          sizes="(min-width: 60em) 28vw, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="band ground-porcelain" id="about" aria-labelledby="about-title">
    <div class="wrap about">
      <Photo class="about__photo" photo={photo('saba/saba-mughal')} zoom={false} sizes="(min-width: 60em) 30vw, 80vw" />
      <div class="about__text">
        <h2 class="display" id="about-title">Saba Mughal</h2>
        <div class="about__copy">
          <p class="lede">
            Saba Mughal is the award-winning hair and makeup artist who founded and runs Haus of Shades Studio.
          </p>
          <p>
            In the studio, appointments are personal and unhurried. On set, Saba leads the team for agencies,
            photographers and fashion houses, from creative shoots to the runway.
          </p>
        </div>
        <a class="text-link" href={site.instagram} target="_blank" rel="noopener">
          Follow the work on Instagram<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(2.5rem, 5.5vw, 4rem) clamp(3rem, 7vw, 5rem); }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__title {
    font-size: clamp(2.15rem, 1.25rem + 3.6vw, var(--step-6));
    line-height: 1.05;
  }
  .hero__title span {
    display: block;
    text-wrap: balance;
  }
  .hero__lede {
    max-width: 30rem;
    margin-top: 1rem;
    text-wrap: balance;
    color: var(--sand);
    font-size: clamp(var(--step-0), 0.95rem + 0.35vw, var(--step-1));
    line-height: 1.5;
  }
  /* Two lines from tablet up; three on phones. */
  @media (min-width: 48em) {
    .hero__lede { max-width: 42rem; }
  }
  .hero__inner :global(.quad) {
    max-width: 64rem;
    margin-top: clamp(2rem, 4.5vw, 3rem);
  }
  .hero__actions {
    justify-content: center;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  /* Shared studio section pieces */
  .lede + .actions { margin-top: 1.75rem; }
  .actions + .text-link { display: inline-block; margin-top: 1.25rem; }
  .display + .lede { margin-top: 1.25rem; }

  /* Hair */
  .hair {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(2rem, 5vw, 3rem) var(--gap);
  }
  .hair__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  .hair__row :global(.photo) { aspect-ratio: 4 / 5; }
  @media (min-width: 60em) {
    .hair {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .hair__text { grid-column: 1 / span 5; }
    .hair__row { grid-column: 1 / span 6; }
    .hair :global(.hair__ba) { grid-column: 7 / -1; grid-row: 1 / span 2; }
  }

  /* Beauty */
  .beauty {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 60em) {
    .beauty {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .beauty__title { grid-column: 1 / span 5; }
    .beauty__text { grid-column: 7 / -1; }
  }
  .faces {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(64vw, 18rem);
    gap: var(--gap);
    margin-block: clamp(2.5rem, 5vw, 3.5rem) 1.5rem;
    padding: 0 var(--gutter) 0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .faces::-webkit-scrollbar { display: none; }
  .faces li { scroll-snap-align: start; }
  .faces :global(.photo) { aspect-ratio: 3 / 4; }
  @media (min-width: 60em) {
    .faces {
      grid-auto-flow: row;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      max-width: 86rem;
      margin-inline: auto;
      overflow: visible;
    }
  }

  /* Bridal */
  .bridal {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 60em) {
    .bridal {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
    }
    .bridal :global(.bridal__photo) { grid-column: 1 / span 5; }
    .bridal__text { grid-column: 7 / -1; }
  }
  .steps {
    display: grid;
    gap: 0;
    margin-top: 2rem;
    counter-reset: step;
    border-top: 1px solid var(--rule);
  }
  .steps li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 0.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    counter-increment: step;
  }
  .steps li::before {
    content: counter(step);
    grid-row: 1 / span 2;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
  }
  .steps h3 { font-size: var(--step-1); line-height: 1.3; }
  .steps p { color: var(--ink-soft); }
  .steps + .actions { margin-top: 2rem; }

  /* Creative */
  .creative {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem) var(--gap);
  }
  .creative__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
  }
  .creative__row :global(.photo) { aspect-ratio: 4 / 5; }
  @media (min-width: 60em) {
    .creative {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
      align-items: start;
    }
    .creative__text { grid-column: 1 / span 5; }
    .creative :global(.creative__lead) { grid-column: 7 / -1; grid-row: 1 / span 2; }
    .creative__row { grid-column: 1 / span 5; }
  }

  /* On set */
  .on-set {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem) var(--gap);
  }
  .on-set__text .display { font-size: clamp(var(--step-3), 1.5rem + 2.2vw, var(--step-5)); }
  .on-set__sheet h3 { font-size: var(--step-1); margin-bottom: 1rem; }
  .call-sheet { border-top: 1px solid var(--rule); }
  .call-sheet div {
    display: grid;
    gap: 0.15rem 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .call-sheet dt { font-weight: 500; }
  .call-sheet dd { color: var(--ink-soft); }
  @media (min-width: 40em) {
    .call-sheet div { grid-template-columns: 11rem minmax(0, 1fr); }
  }
  .on-set__photos {
    display: grid;
    gap: var(--gap);
  }
  .on-set__photos :global(.on-set__wide) { aspect-ratio: 3 / 2; }
  .on-set__photos :global(.on-set__tall) { aspect-ratio: 4 / 5; }
  @media (min-width: 60em) {
    .on-set { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .on-set__text { grid-column: 1 / span 6; }
    .on-set__sheet { grid-column: 8 / -1; align-self: end; }
    .on-set__photos {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
    .on-set__photos :global(.on-set__wide),
    .on-set__photos :global(.on-set__tall) { aspect-ratio: auto; height: clamp(22rem, 38vw, 34rem); }
  }

  /* About */
  .about {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }
  .about :global(.about__photo) { max-width: 26rem; }
  .about__copy {
    display: grid;
    gap: 1rem;
    max-width: var(--measure);
    margin-top: 1.25rem;
  }
  .about__copy + .text-link { display: inline-block; margin-top: 1.5rem; }
  @media (min-width: 60em) {
    .about {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
    }
    .about :global(.about__photo) { grid-column: 2 / span 4; }
    .about__text { grid-column: 7 / -1; }
  }
</style>
