---
// A round photo inside a double ring, like a pressed pan in an eyeshadow palette.
// Used for the four studios only: the quad on the home page, studio page
// headers, and the link to the next studio.
import { Image } from 'astro:assets';
import type { Photo } from '../lib/photos';

interface Props {
  photo: Photo;
  /** Rendered sizes attribute for the photo. */
  sizes: string;
  /** Alt text; leave empty when the pan sits inside a labelled link. */
  alt?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { photo, sizes, alt = '', loading = 'lazy', class: className } = Astro.props;
---

<span class:list={['pan', className]}>
  <Image
    class="pan__photo"
    src={photo.src}
    alt={alt}
    widths={[240, 360, 480, 640, 800]}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === 'eager' ? 'high' : undefined}
    style={`object-position: ${photo.focus}`}
  />
  <svg class="pan__rings" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <circle class="pan__ring pan__ring--inner" cx="50" cy="50" r="46.25" pathLength="100"></circle>
    <circle class="pan__ring pan__ring--outer" cx="50" cy="50" r="49.25" pathLength="100"></circle>
  </svg>
</span>

<style>
  .pan {
    position: relative;
    display: block;
    aspect-ratio: 1;
    width: 100%;
  }
  .pan__photo {
    position: absolute;
    inset: 8.5%;
    width: 83%;
    height: 83%;
    border-radius: 50%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  /* A soft rim so the photo reads as pressed into its pan. */
  .pan::after {
    content: "";
    position: absolute;
    inset: 8.5%;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 1px rgb(42 17 25 / 0.28),
      inset 0 0.35rem 1rem rgb(42 17 25 / 0.28);
    pointer-events: none;
  }
  .pan__rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .pan__ring {
    fill: none;
    stroke: var(--ring);
    stroke-width: 0.45;
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
    transition: stroke 0.3s;
  }
  .pan__ring--outer { transform: rotate(-90deg) scaleY(-1); }
</style>
