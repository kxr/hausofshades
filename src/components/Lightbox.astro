---
// Opens any `a[data-zoom]` photo full screen. Arrows, swipe and Escape work;
// photos within the same `[data-zoom-group]` are stepped through together.
---

<dialog class="lightbox" aria-label="Photo viewer">
  <figure class="lightbox__frame">
    <img class="lightbox__img" alt="" />
  </figure>
  <p class="lightbox__count" aria-live="polite"></p>
  <button class="lightbox__btn lightbox__close" type="button" aria-label="Close">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
  </button>
  <button class="lightbox__btn lightbox__prev" type="button" aria-label="Previous photo">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
  </button>
  <button class="lightbox__btn lightbox__next" type="button" aria-label="Next photo">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const img = dialog?.querySelector<HTMLImageElement>('.lightbox__img');
  const count = dialog?.querySelector<HTMLElement>('.lightbox__count');

  if (dialog && img && count) {
    let group: HTMLAnchorElement[] = [];
    let index = 0;

    const show = (i: number) => {
      index = (i + group.length) % group.length;
      const link = group[index];
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      count.textContent = group.length > 1 ? `${index + 1} of ${group.length}` : '';
      dialog.toggleAttribute('data-single', group.length < 2);
    };

    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-zoom]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      const scope = link.closest('[data-zoom-group]') ?? document;
      group = [...scope.querySelectorAll<HTMLAnchorElement>('a[data-zoom]')];
      show(group.indexOf(link));
      dialog.showModal();
    });

    dialog.querySelector('.lightbox__close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lightbox__prev')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lightbox__next')?.addEventListener('click', () => show(index + 1));

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    let startX = 0;
    let swiped = false;
    dialog.addEventListener('pointerdown', (event) => (startX = event.clientX));
    dialog.addEventListener('pointerup', (event) => {
      const dx = event.clientX - startX;
      swiped = Math.abs(dx) > 48;
      if (swiped && group.length > 1) show(dx < 0 ? index + 1 : index - 1);
    });

    // Clicking the dark surround (not the photo or a button) closes the viewer.
    dialog.addEventListener('click', (event) => {
      if (swiped) return void (swiped = false);
      const target = event.target as Element;
      if (target === dialog || target.classList.contains('lightbox__frame')) dialog.close();
    });

    dialog.addEventListener('close', () => img.removeAttribute('src'));
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--deep-plum);
    color: var(--porcelain);
    overscroll-behavior: contain;
  }
  .lightbox::backdrop { background: var(--deep-plum); }
  .lightbox[open] { display: grid; animation: lightbox-in 0.2s ease-out; }
  :global(html:has(.lightbox[open])) { overflow: hidden; }
  .lightbox__frame {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 4rem 0.75rem 3.5rem;
  }
  @media (min-width: 48em) {
    .lightbox__frame { padding: 3.5rem 5.5rem; }
  }
  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    touch-action: pan-y;
  }
  .lightbox__count {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    translate: -50% 0;
    font-size: 0.875rem;
    color: var(--sand);
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid rgb(234 219 200 / 0.4);
    border-radius: 50%;
    background: rgb(42 17 25 / 0.6);
    color: var(--porcelain);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .lightbox__btn:hover { background: var(--plum); border-color: var(--sand); }
  .lightbox__btn:focus-visible { outline: 2px solid var(--sand); outline-offset: 3px; }
  .lightbox__btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lightbox__close { top: 0.75rem; right: 0.75rem; }
  .lightbox__prev, .lightbox__next { bottom: 0.5rem; }
  .lightbox__prev { left: 0.75rem; }
  .lightbox__next { right: 0.75rem; }
  @media (min-width: 48em) {
    .lightbox__prev, .lightbox__next { bottom: auto; top: 50%; translate: 0 -50%; }
    .lightbox__prev { left: 1.25rem; }
    .lightbox__next { right: 1.25rem; }
    .lightbox__close { top: 1.25rem; right: 1.25rem; }
  }
  .lightbox[data-single] .lightbox__prev,
  .lightbox[data-single] .lightbox__next { display: none; }
  @keyframes lightbox-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
