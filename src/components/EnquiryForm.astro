---
// Sends to site.formEndpoint when set (Formspree-style JSON response).
// Without an endpoint it opens the visitor's email app with the enquiry written out.
import { site } from '../site.config';
import { url } from '../lib/paths';

const types = [
  { value: 'agency', label: 'Agency or production' },
  { value: 'bridal', label: 'Bridal' },
  { value: 'creative', label: 'Creative shoot' },
  { value: 'hair', label: 'Hair' },
  { value: 'beauty', label: 'Beauty and makeup' },
];

const endpoint = site.formEndpoint;
---

<form
  class="enquiry"
  method="post"
  action={endpoint || `mailto:${site.email}`}
  enctype={endpoint ? undefined : 'text/plain'}
  data-endpoint={endpoint}
  data-email={site.email}
  novalidate
>
  <fieldset class="field choice-group" aria-describedby="for-error">
    <legend class="field__label">What’s the enquiry for?</legend>
    <div class="choices">
      {
        types.map((t) => (
          <label class="choice">
            <input type="radio" name="enquiry_for" value={t.value} required />
            <span>{t.label}</span>
          </label>
        ))
      }
    </div>
    <p class="field__error" id="for-error" hidden>Choose what the enquiry is for.</p>
  </fieldset>

  <p class="fresha-note" data-show-for="hair beauty" hidden>
    Booking a cut, colour or makeup appointment? You can pick a time now on <a
      href={site.fresha}
      target="_blank"
      rel="noopener">Fresha<span class="visually-hidden"> (opens in a new tab)</span></a
    >.
  </p>

  <div class="fields">
    <div class="field">
      <label class="field__label" for="f-name">Name</label>
      <input id="f-name" name="name" autocomplete="name" required aria-describedby="name-error" />
      <p class="field__error" id="name-error" hidden>Enter your name.</p>
    </div>

    <div class="field">
      <label class="field__label" for="f-email">Email</label>
      <input
        id="f-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        aria-describedby="email-error"
      />
      <p class="field__error" id="email-error" hidden>Enter an email address like name@example.com.</p>
    </div>

    <div class="field">
      <label class="field__label" for="f-phone">Phone <span class="field__optional">(optional)</span></label>
      <input id="f-phone" name="phone" type="tel" autocomplete="tel" />
    </div>

    <div class="field" data-show-for="agency creative">
      <label class="field__label" for="f-company">
        Agency or company <span class="field__optional">(optional)</span>
      </label>
      <input id="f-company" name="company" autocomplete="organization" />
    </div>

    <div class="field">
      <label class="field__label" for="f-date">Date <span class="field__optional">(optional)</span></label>
      <input id="f-date" name="date" type="date" aria-describedby="date-hint" />
      <p class="field__hint" id="date-hint">Your event, wedding or shoot date.</p>
    </div>

    <div class="field">
      <label class="field__label" for="f-location">Location <span class="field__optional">(optional)</span></label>
      <input id="f-location" name="location" aria-describedby="location-hint" />
      <p class="field__hint" id="location-hint">Suburb, venue or studio address.</p>
    </div>

    <div class="field">
      <label class="field__label" for="f-people">
        People needing hair or makeup <span class="field__optional">(optional)</span>
      </label>
      <input id="f-people" name="people" type="number" min="1" inputmode="numeric" />
    </div>

    <div class="field field--wide">
      <label class="field__label" for="f-message">Details</label>
      <textarea id="f-message" name="message" rows="6" required aria-describedby="message-hint message-error"></textarea>
      <p class="field__hint" id="message-hint" data-default="Tell us what you have in mind.">
        Tell us what you have in mind.
      </p>
      <p class="field__error" id="message-error" hidden>Add a few details about what you need.</p>
    </div>
  </div>

  <input type="hidden" name="_subject" value="New enquiry from the website" />
  <div class="trap" aria-hidden="true">
    <label for="f-website">Leave this empty</label>
    <input id="f-website" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>

  <div class="enquiry__submit">
    <button class="btn" type="submit">Send enquiry</button>
    <p class="enquiry__status" role="status" aria-live="polite"></p>
  </div>
</form>

<div class="enquiry-sent" hidden tabindex="-1">
  <h2>Enquiry sent</h2>
  <p class="enquiry-sent__copy"></p>
  <a class="text-link" href={url('')}>Back to the home page</a>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('form.enquiry');

  const hints: Record<string, string> = {
    agency: 'Include the call time, how many talent and looks, and a link to your mood board.',
    bridal: 'Include your venue, the time you need to be ready, and who needs hair or makeup.',
    creative: 'Include the concept, how many looks, and a link to your mood board.',
    hair: 'Tell us your hair length and what you would like done.',
    beauty: 'Tell us the occasion and the look you have in mind.',
  };
  const labels: Record<string, string> = {
    agency: 'Agency or production',
    bridal: 'Bridal',
    creative: 'Creative shoot',
    hair: 'Hair',
    beauty: 'Beauty and makeup',
  };

  if (form) {
    const email = form.dataset.email ?? '';
    const endpoint = form.dataset.endpoint ?? '';
    const status = form.querySelector<HTMLElement>('.enquiry__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const hint = form.querySelector<HTMLElement>('#message-hint')!;
    const radios = [...form.querySelectorAll<HTMLInputElement>('input[name="enquiry_for"]')];
    const chosen = () => radios.find((r) => r.checked)?.value ?? '';

    const update = () => {
      const value = chosen();
      form.querySelectorAll<HTMLElement>('[data-show-for]').forEach((el) => {
        const match = el.dataset.showFor!.split(' ').includes(value);
        // Notes appear only for a match; fields stay visible until a type is chosen.
        el.hidden = el.matches('.fresha-note') ? !match : !!value && !match;
      });
      hint.textContent = hints[value] ?? hint.dataset.default ?? '';
    };

    const preset = new URLSearchParams(location.search).get('for');
    const presetRadio = radios.find((r) => r.value === preset);
    if (presetRadio) presetRadio.checked = true;
    update();
    form.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === 'enquiry_for') {
        update();
        showError('for', false);
      }
    });

    const showError = (key: string, show: boolean) => {
      const error = form.querySelector<HTMLElement>(`#${key}-error`);
      if (error) error.hidden = !show;
      const control = key === 'for' ? null : form.querySelector<HTMLElement>(`[aria-describedby~="${key}-error"]`);
      control?.toggleAttribute('aria-invalid', show);
      if (key === 'for') form.querySelector('.choice-group')?.toggleAttribute('data-invalid', show);
    };

    const filled = (id: string) => {
      const control = form.querySelector<HTMLInputElement>(`#${id}`)!;
      return control.value.trim() !== '' && control.checkValidity();
    };

    const validate = () => {
      const checks: [key: string, control: HTMLElement, ok: boolean][] = [
        ['for', radios[0], !!chosen()],
        ['name', form.querySelector('#f-name')!, filled('f-name')],
        ['email', form.querySelector('#f-email')!, filled('f-email')],
        ['message', form.querySelector('#f-message')!, filled('f-message')],
      ];
      const failed = checks.filter(([key, , ok]) => {
        showError(key, !ok);
        return !ok;
      });
      failed[0]?.[1].focus();
      return failed.length === 0;
    };

    // Clear a field's error as soon as it is fixed.
    form.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement;
      const key = target.getAttribute('aria-describedby')?.match(/(\w+)-error/)?.[1];
      if (key && target.hasAttribute('aria-invalid') && target.value.trim() !== '' && target.checkValidity()) {
        showError(key, false);
      }
    });

    const describe = (data: FormData) => {
      const rows: [string, FormDataEntryValue | null][] = [
        ['Enquiry for', labels[String(data.get('enquiry_for'))] ?? ''],
        ['Name', data.get('name')],
        ['Email', data.get('email')],
        ['Phone', data.get('phone')],
        ['Agency or company', data.get('company')],
        ['Date', data.get('date')],
        ['Location', data.get('location')],
        ['People', data.get('people')],
      ];
      return rows
        .filter(([, value]) => value && String(value).trim())
        .map(([label, value]) => `${label}: ${value}`)
        .join('\n');
    };

    const sent = (name: string, address: string) => {
      const panel = document.querySelector<HTMLElement>('.enquiry-sent')!;
      panel.querySelector('.enquiry-sent__copy')!.textContent =
        `Thanks, ${name}. The team will reply to ${address}.`;
      form.hidden = true;
      panel.hidden = false;
      panel.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      if (!validate()) return;

      const data = new FormData(form);
      const name = String(data.get('name')).trim();
      const address = String(data.get('email')).trim();
      const type = labels[String(data.get('enquiry_for'))] ?? 'General';
      const subject = `Website enquiry: ${type}, from ${name}`;
      data.set('_subject', subject);

      // Bots fill the hidden field; act as if it worked and send nothing.
      if (String(data.get('_gotcha') ?? '') !== '') return sent(name, address);

      if (!endpoint) {
        const body = `${describe(data)}\n\n${String(data.get('message')).trim()}`;
        location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        status.textContent = `Your email app should open with the enquiry written out. Press send there to finish. If nothing opened, email ${email}.`;
        return;
      }

      button.disabled = true;
      button.textContent = 'Sending…';
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));
        sent(name, address);
      } catch {
        status.textContent = `The enquiry didn’t send. Check your connection and try again, or email ${email}.`;
        button.disabled = false;
        button.textContent = 'Send enquiry';
      }
    });
  }
</script>

<style>
  .enquiry { display: grid; gap: 2rem; }
  .choice-group {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
  .choice { position: relative; }
  .choice input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .choice span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.15rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: #fff;
    font-weight: 500;
    font-size: 0.9375rem;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .choice:hover span { border-color: var(--plum); }
  .choice input:checked + span {
    border-color: var(--plum);
    background: var(--plum);
    color: var(--porcelain);
  }
  .choice input:focus-visible + span { outline: 2px solid var(--plum); outline-offset: 3px; }
  .choice-group[data-invalid] .choice span { border-color: var(--error); }

  .fresha-note {
    padding: 0.9rem 1.15rem;
    border-radius: 0.75rem;
    background: var(--sand);
    font-size: 0.9375rem;
  }

  .fields {
    display: grid;
    gap: 1.5rem 1.25rem;
  }
  @media (min-width: 40em) {
    .fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field--wide { grid-column: 1 / -1; }
  }
  .field { display: grid; gap: 0.4rem; align-content: start; }
  .field[hidden] { display: none; }
  .field__label { font-weight: 500; }
  .field__optional { font-weight: 400; color: var(--plum-soft); }
  .field input,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid rgb(75 30 50 / 0.35);
    border-radius: 0.6rem;
    background: #fff;
    font-size: 1rem;
    line-height: 1.4;
    transition: border-color 0.2s;
  }
  .field textarea { resize: vertical; min-height: 9rem; }
  .field input:hover,
  .field textarea:hover { border-color: var(--plum); }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--plum);
    outline-offset: 1px;
    border-color: var(--plum);
  }
  .field [aria-invalid] { border-color: var(--error); }
  .field__hint { font-size: 0.875rem; color: var(--plum-soft); }
  .field__error {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--error);
  }
  .trap {
    position: absolute;
    left: -100vw;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .enquiry__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .enquiry__status { max-width: 32rem; font-size: 0.9375rem; }
  .enquiry__status:empty { display: none; }

  .enquiry-sent {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: 2rem;
    border-radius: 1.5rem;
    background: var(--sand);
    outline: none;
  }
  .enquiry-sent[hidden] { display: none; }
  .enquiry-sent h2 { font-size: var(--step-4); }
</style>
