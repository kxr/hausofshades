---
// The home page hero object: a compact holding one pan per studio.
import Pan from './Pan.astro';
import { studios } from '../data/studios';
import { photo } from '../lib/photos';
import { url } from '../lib/paths';
---

<nav class="quad" aria-label="Studios">
  <ul class="quad__pans" role="list">
    {
      studios.map((s, i) => (
        <li style={`--i: ${i}`}>
          <a class="quad__link" href={url(`${s.slug}/`)}>
            <Pan
              photo={photo(s.pan)}
              sizes="(min-width: 64em) 15rem, (min-width: 45em) 20vw, 38vw"
              loading="eager"
            />
            <span class="quad__name">{s.name}</span>
            <span class="quad__line">{s.line}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .quad {
    --ring: var(--sand);
    width: 100%;
    padding: clamp(1.25rem, 4.5vw, 3rem) clamp(0.75rem, 3.5vw, 3rem) clamp(1.5rem, 4.5vw, 2.75rem);
    border: 1px solid rgb(234 219 200 / 0.2);
    border-radius: clamp(1.75rem, 5vw, 3.25rem);
    background: var(--deep-plum);
    color: var(--porcelain);
  }
  .quad__pans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 5vw, 2.5rem) clamp(0.75rem, 3vw, 2.5rem);
    margin: 0;
  }
  @media (min-width: 45em) {
    .quad__pans { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .quad__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    border-radius: 1.25rem;
  }
  .quad__link :global(.pan) {
    width: min(100%, 15rem);
    margin-bottom: clamp(0.75rem, 2vw, 1.1rem);
  }
  .quad__name {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 0.95rem + 0.8vw, var(--step-2));
    line-height: 1.15;
  }
  .quad__line {
    margin-top: 0.3rem;
    color: var(--sand);
    font-size: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);
    line-height: 1.35;
  }
  .quad__link:focus-visible { outline-color: var(--sand); outline-offset: 6px; }

  /* Hover answers the pointer: the pan's rings warm to blush, the photo leans in. */
  .quad__link:hover :global(.pan__ring) { stroke: var(--blush); }
  .quad__link:hover :global(.pan__photo) { transform: scale(1.05); }

  /* The page's one entrance: rings draw in, then each pan opens. */
  @media (prefers-reduced-motion: no-preference) {
    .quad :global(.pan__ring) {
      stroke-dasharray: 100;
      animation: ring-draw 1.1s cubic-bezier(0.6, 0, 0.2, 1) backwards;
      animation-delay: calc(var(--i) * 0.11s);
    }
    .quad :global(.pan__photo) {
      animation: pan-open 0.95s var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 0.11s + 0.35s);
    }
    .quad__name, .quad__line {
      animation: label-in 0.7s var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 0.11s + 0.6s);
    }
  }
  @keyframes ring-draw {
    from { stroke-dashoffset: 100; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes pan-open {
    from { clip-path: circle(0% at 50% 50%); scale: 1.12; }
    to { clip-path: circle(50% at 50% 50%); scale: 1; }
  }
  @keyframes label-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
